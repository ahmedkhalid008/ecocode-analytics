# EcoCode Analytics - Environment Configuration Example

ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL Configuration
POSTGRES_USER=ecocode
POSTGRES_PASSWORD=ecocode_secret
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecocode_db

# Primary Database Connection URL (Synchronous)
DATABASE_URL=postgresql+psycopg2://ecocode:ecocode_secret@localhost:5432/ecocode_db

# Secondary Asynchronous Connection URL (Optional override)
# ASYNC_DATABASE_URL=postgresql+asyncpg://ecocode:ecocode_secret@localhost:5432/ecocode_db
